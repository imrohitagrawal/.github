{
  // WP1 (first-party quality gate, F1/F25): config for the markdownlint step
  // in .github/workflows/self-lint.yml, scoped to docs/*.md, README.md,
  // templates/AGENTS.md, and this repo's own root AGENTS.md — the same set
  // of files that step actually lints (round-2 review fix, real Codex
  // finding: an earlier version of this comment omitted the root AGENTS.md,
  // even though self-lint.yml's own command already covered it).
  //
  // MD013 (line-length) disabled: this repo's docs (and the audit plan they
  // implement) deliberately use long, information-dense paragraphs and
  // single-line list items rather than hard-wrapping at 80 chars — enforcing
  // a wrap width would just reformat prose without fixing anything real.
  //
  // MD031 (blanks-around-fences) disabled: docs/repo-onboarding.md and
  // docs/branch-protection.md intentionally keep fenced code blocks tight
  // inside numbered list items (no blank line before/after the fence) so the
  // fence stays part of the same list item instead of breaking the list —
  // GitHub's renderer handles this fine either way, and forcing blank lines
  // here would risk turning a tight list into a loose one for no benefit.
  //
  // Every other rule (including MD032, MD040, MD047, MD060) is left at
  // markdownlint-cli's default and is genuinely clean as of this commit —
  // verified via `npx --yes markdownlint-cli@0.49.1 --config
  // .markdownlint.jsonc docs/*.md README.md templates/AGENTS.md` returning
  // exit 0. Baseline check: with only MD013 disabled, the same command
  // surfaced ~30 additional MD031 findings that were already true of these
  // docs before WP1 (unrelated to WP1's own changes) — MD031 was disabled
  // for the stated content reason above, not to hide something WP1 caused.
  "MD013": false,
  "MD031": false
}
