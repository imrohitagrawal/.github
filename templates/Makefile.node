.PHONY: install lint typecheck test build audit ci

# Makefile template for Node repos consuming imrohitagrawal/.github's
# reusable-pr-quality.yml. Severity policy mirrors the reusable workflow's
# native Node path exactly (see .github/workflows/reusable-pr-quality.yml,
# the WP5 comment block above `jobs:`) so a repo gets the same behavior
# whether the reusable workflow's native steps run or these discrete
# targets do.
#
# ROUND-4 FIX (MEDIUM): this file used to hardcode `npm ci` and `npm run
# ... --if-present` unconditionally, with no pnpm/yarn branch at all - so H1's
# package-manager dispatch (which fixed exactly this in the workflow's own
# native path) never reached the Makefile onboarding route. A pnpm-only or
# yarn-only repo that onboarded via scripts/retrofit-quality-gate.sh and
# adopted this recommended root Makefile reproduced the ORIGINAL H1 hard
# failure - `npm ci` on a repo with no package-lock.json - just through the
# Makefile path instead of the native one. PKG_MANAGER below closes that with
# the same precedence the workflow uses, so onboarding by either route
# behaves identically.
#
# PKG_MANAGER precedence, identical to the workflow's "Detect project layout"
# step: package.json's `packageManager` field first (Corepack's own field, so
# setting it also pins the exact version), then pnpm-lock.yaml, then
# yarn.lock, then npm. Anything outside the npm/pnpm/yarn allowlist falls
# back to npm rather than being passed through - the value reaches a `case`
# statement, and an unvalidated one taken from repo content is a shell
# injection vector (the same finding that produced the workflow's own
# allowlist). Resolved once at parse time via `$(shell ...)`, not per target.
#
# pnpm/yarn availability: the reusable workflow runs `corepack enable` before
# any `make` target, so the shims exist there. Running these targets by hand
# on a pnpm/yarn repo needs that manager on PATH, same as any other local
# build step.
#
# Every check target below depends on `install` (Codex review, Phase 4):
# the reusable workflow's "Run make lint"/"Run make typecheck"/
# "Run make test" steps run BEFORE its own dependency-install step - a
# pre-existing ordering gap from WP7, out of WP8's scope to fix in the
# workflow file itself, but fixable here by making each target self-contained
# (installs node_modules itself) rather than assuming the workflow already
# installed anything. `.PHONY` targets only execute once per `make`
# invocation even when several downstream targets share `install` as a
# prerequisite.
# KNOWN, ACCEPTED RESIDUAL (Codex review, Phase 4 Round 2): the dedup above
# only holds WITHIN one `make` invocation. The reusable workflow's "Run
# make lint"/"Run make typecheck"/"Run make test" steps are three SEPARATE
# `run: make <target>` steps, each its own `make` process - so `install`
# actually reruns once per step in that path (3x), not once total. Every
# rerun is idempotent (`npm ci`/`pnpm install --frozen-lockfile`/`yarn
# install --immutable` all skip already-satisfied installs) - a real
# wall-clock cost, not a correctness issue. Not fixed here: doing so would
# mean either the workflow chaining these into one step (a workflow-file
# change, out of WP8's scope) or this Makefile caching install state
# across invocations (meaningful complexity for a template file, not
# worth it for a cost that's slower-but-correct).
#
# Script existence is checked with `node` rather than assuming a manager's
# own "run a possibly-missing script" flag, for the same reason the workflow
# gives at its Node lint step: npm's `--if-present` is verified to no-op
# cleanly, pnpm's and yarn's equivalents were not independently verified, and
# one manager-agnostic check in front of all three avoids trusting an
# unverified flag. Node itself is already a hard requirement to run anything
# here, so this adds no dependency (and no jq).
#
# npm audit is ADVISORY by default, promotable to BLOCKING using the exact
# same convention WP5 wired into the reusable workflow: ship an audit-ci
# config, checked in this order - audit-ci.jsonc, then audit-ci.json, then
# .audit-ci.json - and this target invokes the real `audit-ci` tool (via
# npx) against it instead of bare `npm audit`, since bare `npm audit`
# cannot consume an allowlist at all. `--high` is always passed explicitly
# on the CLI, not left to the repo's config file: an audit-ci config that
# sets no severity field of its own silently exits 0 even against a real
# critical CVE (verified against audit-ci 7.1.0's own source) - `--high`
# forces a floor of "high or higher" regardless of what the config omits,
# without loosening a stricter repo choice (audit-ci takes the strictest
# severity set to true from either source). The BLOCKING path works for all
# three managers unchanged - audit-ci detects the manager from the lockfile
# itself.
# Advisory mode separates "found something real" (warning, exit 0) from
# "the scanner itself failed to run" (hard failure), same as the native
# npm-audit step, by checking captured JSON output for a real
# "vulnerabilities" key. Parsed with `node -e` (Codex review, Phase 4: this
# is a Node template, so Node itself - already a hard requirement to run
# anything here - can parse JSON reliably; no jq dependency, no grep
# substring-match fallback needed).
# ADVISORY mode is npm-only, matching the workflow exactly: its
# crash-vs-finding JSON parsing was verified against npm's own `audit --json`
# output shape, and pnpm's/yarn's shapes were not - a pnpm/yarn repo gets an
# explicit notice rather than a silently mis-parsed result.

# NOTE for whoever edits this: no `case` statement inside `$(shell ...)`.
# Make finds the closing paren of a `$(...)` call by counting parentheses, so
# an unbalanced `)` - which every `case` pattern ends with - truncates the
# command mid-string and produces a baffling `/bin/sh: syntax error` at parse
# time for every target in the file. The allowlist below is an `if` chain for
# that reason, not for style.
PKG_MANAGER := $(shell \
	pm=""; \
	if [ -f package.json ]; then \
		pm=$$(node -e 'try{const p=require("./package.json").packageManager;if(typeof p==="string")process.stdout.write(p.split("@")[0])}catch(e){}' 2>/dev/null || true); \
	fi; \
	if [ -z "$$pm" ]; then \
		if [ -f pnpm-lock.yaml ]; then pm=pnpm; \
		elif [ -f yarn.lock ]; then pm=yarn; \
		else pm=npm; fi; \
	fi; \
	if [ "$$pm" != npm ] && [ "$$pm" != pnpm ] && [ "$$pm" != yarn ]; then pm=npm; fi; \
	printf '%s' "$$pm")

# $(call run_pkg_script,<npm script name>) - run that script with the
# detected manager, or say so and skip if package.json doesn't declare it.
define run_pkg_script
@if node -e 'const s=(require("./package.json").scripts)||{};process.exit(s["$(1)"]?0:1)' 2>/dev/null; then \
	case "$(PKG_MANAGER)" in \
	pnpm) pnpm run $(1) ;; \
	yarn) yarn run $(1) ;; \
	*) npm run $(1) --if-present ;; \
	esac; \
else \
	echo "$(1): package.json declares no \"$(1)\" script - skipping (same as the native workflow's own existence check)"; \
fi
endef

install:
	@case "$(PKG_MANAGER)" in \
	pnpm) pnpm install --frozen-lockfile ;; \
	yarn) yarn install --immutable ;; \
	*) npm ci ;; \
	esac

lint: install
	$(call run_pkg_script,lint)

typecheck: install
	$(call run_pkg_script,typecheck)

test: install
	$(call run_pkg_script,test)

build: install
	$(call run_pkg_script,build)

# ADVISORY by default. BLOCKING WHEN an audit-ci config is present (see
# header comment above) - machine-checked below, not just documented here.
audit: install
	@config=""; \
	if [ -f audit-ci.jsonc ]; then config=audit-ci.jsonc; \
	elif [ -f audit-ci.json ]; then config=audit-ci.json; \
	elif [ -f .audit-ci.json ]; then config=.audit-ci.json; \
	fi; \
	if [ -n "$$config" ]; then \
		echo "npm audit: $$config found - running BLOCKING (audit-ci) mode"; \
		npx --yes audit-ci@7.1.0 --config "$$config" --high; \
	elif [ "$(PKG_MANAGER)" != npm ]; then \
		echo "WARNING: advisory dependency audit is only implemented for npm today (this repo uses $(PKG_MANAGER)). Add an audit-ci config to get BLOCKING coverage instead (audit-ci auto-detects pnpm/yarn) - see docs/repo-onboarding.md."; \
	else \
		set +e; \
		output=$$(npm audit --audit-level=high --json); \
		code=$$?; \
		set -e; \
		if [ "$$code" -eq 0 ]; then \
			echo "npm audit: no high+ severity advisories."; \
		elif printf '%s' "$$output" | node -e 'let d="";process.stdin.on("data",c=>d+=c);process.stdin.on("end",()=>{try{const j=JSON.parse(d);process.exit(Object.prototype.hasOwnProperty.call(j,"vulnerabilities")?0:1)}catch(e){process.exit(1)}})'; then \
			echo "$$output"; \
			echo "WARNING: npm audit found high+ advisories (advisory - not blocking; add an audit-ci config to promote)"; \
		else \
			echo "$$output"; \
			echo "ERROR: npm audit failed to run (exit $$code) - not a genuine vulnerability report"; \
			exit "$$code"; \
		fi; \
	fi

ci: install lint typecheck test build audit
